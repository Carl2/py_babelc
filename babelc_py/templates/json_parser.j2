  template <class CharT, class Target>
  bool isNumericValue( Target       &theConvertedValue,
                       const CharT *theStringToConvert,
                       Target      (*theConverterFunction)( const CharT*, CharT**) ) {

    CharT *theFirstUnused = nullptr;

    errno = 0;

    theConvertedValue = (*theConverterFunction)(theStringToConvert, &theFirstUnused );

    return (errno == 0) && theFirstUnused && !*theFirstUnused;
  }
