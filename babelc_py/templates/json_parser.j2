  template <class CharT, class Traits >
  Value
  readValue( PositionedStream<CharT,Traits> &fromStream ) {
    using StringType = std::basic_string<CharT, Traits>;

    CharT theFirstNonSpace;

    if (skipWhiteSpace(fromStream).get(theFirstNonSpace)) {
      constexpr CharT _DQUOTE  = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'"');
      constexpr CharT _LCURLY  = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'{');
      constexpr CharT _RCURLY  = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'}');
      constexpr CharT _LSQUARE = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'[');
      constexpr CharT _RSQUARE = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,']');

      switch (theFirstNonSpace) {
      case _DQUOTE  : return readString( fromStream );
      case _LCURLY  : return readCommaSeparatedList( fromStream, std::make_unique<Object<StringType>>(fromStream.line(),fromStream.column()), _RCURLY );
      case _LSQUARE : return readCommaSeparatedList( fromStream, std::make_unique<Array>(fromStream.line(),fromStream.column()),              _RSQUARE );
      default:
        {
          constexpr const CharT *_null  = BABEL_JSON_PARSER_STRING_LITERAL(CharT, "null");
          constexpr const CharT *_true  = BABEL_JSON_PARSER_STRING_LITERAL(CharT, "true");
          constexpr const CharT *_false = BABEL_JSON_PARSER_STRING_LITERAL(CharT, "false");
    
          StringType theNextWord(1, theFirstNonSpace);

          if (readWord(fromStream, theNextWord) || fromStream.eof()) {
            if      (theNextWord == _null)  return std::make_unique<Null>(fromStream.line(),fromStream.column());
            else if (theNextWord == _true)  return std::make_unique<Boolean>(true,fromStream.line(),fromStream.column());
            else if (theNextWord == _false) return std::make_unique<Boolean>(false,fromStream.line(),fromStream.column());
            else {
              if (isNumericValue(theNextWord.begin(), theNextWord.end())) {
                return std::make_unique<Number<StringType>>( std::move(theNextWord),fromStream.line(),fromStream.column() );
              }
              else {
                throw fromStream.makePositionedException("JSON parse error when encountering '" + CharTraits<char>::adjust(theNextWord) + "'.");
              }
            }
          }
        }
      }
    }
    return Value();
  }
  //======================================================================

  template <class CharT, class Traits >
  Value
  readValue( std::basic_istream<CharT,Traits> &fromStream ) {
      auto theInput = makePositionedStream(fromStream);
      return readValue(theInput);
  }


