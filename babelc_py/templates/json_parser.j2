  template <class CharT, class Traits, class ListType >
  Value
  readCommaSeparatedList( PositionedStream<CharT,Traits> &fromStream, std::unique_ptr<ListType> &&theList, CharT theDelimiter ) {
    CharT theNextChar;
    
    constexpr CharT _COMMA = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,',');

    if (skipWhiteSpace(fromStream).get(theNextChar)) {
      if (theNextChar == theDelimiter) { return std::move(theList); }
      else                             { fromStream.putback(theNextChar); }

      for (;;) {
        if (!skipWhiteSpace(readItem(fromStream,theList)).get(theNextChar)) { break; }
        else if (theNextChar == theDelimiter)                              { return std::move(theList); }
        else if (theNextChar == _COMMA)                                       { continue; }
        else                                                               { break; }
      }
    }
    throw fromStream.makePositionedException("JSON parse error during comma separated list of values.");
    return Value();
  }

