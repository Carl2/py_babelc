    template <class CharT, class Traits> 
    struct PositionedStream {
        PositionedStream( std::basic_istream<CharT,Traits> &theInput )
        : itsInput(theInput) {
        }
        PositionedStream &get( CharT &theChar ) { 
            if (itsInput.get(theChar)) {
                updatePosition(theChar, 1);
            }
            return *this;
        }
        PositionedStream &putback( CharT theChar ) {
            if (itsInput.putback(theChar)) {
                updatePosition(theChar, -1);
            }
            return *this;
        }
        std::invalid_argument makePositionedException( const std::string &theMessage ) {
            return std::invalid_argument("Close to line " + std::to_string(itsLine) +
                                        " column " + std::to_string(itsColumn) +
                                        ": " + theMessage );
        }
        bool               eof()   const { return itsInput.eof(); }
        explicit operator bool()   const { return !!itsInput;     }
        int               line()   const { return itsLine;        }
        int               column() const { return itsColumn;      }
    private:
        void updatePosition( CharT theChar, int theDelta) {
            // Will break column if going backwards, but it's simpler this way
            switch (theChar) {
                case BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'\n'): itsLine   += theDelta; itsColumn = 1; break;
                case BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'\r'): break;
                default  : itsColumn += theDelta;
            }
        }
        int                               itsLine   = 1;
        int                               itsColumn = 2;
        std::basic_istream<CharT,Traits> &itsInput;
    };
    
  template <class CharT, class Traits>
  PositionedStream<CharT,Traits> makePositionedStream( std::basic_istream< CharT, Traits > &fromStream ) {
      return PositionedStream<CharT,Traits>( fromStream );
  }
  
