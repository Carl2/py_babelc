    template <typename Iterator>
    inline bool isNumericValue( Iterator theStart, Iterator theEnd ) {
        using CharType = std::remove_cv_t< std::remove_reference_t<decltype( *theStart )>>;
        
        constexpr CharType _DOT   = BABEL_JSON_PARSER_CHAR_LITERAL(CharType,'.');
        constexpr CharType _MINUS = BABEL_JSON_PARSER_CHAR_LITERAL(CharType,'-');
        constexpr CharType _PLUS  = BABEL_JSON_PARSER_CHAR_LITERAL(CharType,'+');
        constexpr CharType _e     = BABEL_JSON_PARSER_CHAR_LITERAL(CharType,'e');
        constexpr CharType _E     = BABEL_JSON_PARSER_CHAR_LITERAL(CharType,'E');
        constexpr CharType _0     = BABEL_JSON_PARSER_CHAR_LITERAL(CharType,'0');
        constexpr CharType _1     = BABEL_JSON_PARSER_CHAR_LITERAL(CharType,'1');
        constexpr CharType _9     = BABEL_JSON_PARSER_CHAR_LITERAL(CharType,'9');
        
        if (theStart == theEnd) { return false; }
        
        if (*theStart == _MINUS) {
            theStart++;
        }
        if (theStart == theEnd) { return false; }
        
        if (*theStart == _0) {
            theStart++;
        }
        else if ((*theStart < _1) || (_9 < *theStart)) {
            return false;
        }
        else {
            do {
                theStart++;
            } while ((theStart != theEnd) && (_0 <= *theStart) && (*theStart <= _9));
        }
        
        if (theStart == theEnd) { return true; } // Integer w/o exponent
        
        if (*theStart == _DOT) {
            if (++theStart == theEnd || ((*theStart < _0) || (_9 < *theStart))) { return false; }
            do {
                theStart++;
            } while ((theStart != theEnd) && (_0 <= *theStart) && (*theStart <= _9));
        }

        if (theStart == theEnd) { return true; } // Float w/o exponent
        
        if ((*theStart != _e) && (*theStart != _E)) { return false; }
        
        if (++theStart == theEnd) { return false; }
        
        if ((*theStart == _MINUS) || (*theStart == _PLUS)) {
            if (++theStart == theEnd) { return false; }
        }
        while ((_0 <= *theStart) && (*theStart <= _9) && (++theStart != theEnd)) {
            ;
        }
        return (theStart == theEnd);
    }


