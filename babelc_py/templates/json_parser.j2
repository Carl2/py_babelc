  template <typename CharT>
  struct CharTraits {      
  };
  
  template <>
  struct CharTraits<char> {
      using CharType        = char;
      using OtherCharType   = wchar_t;
      using StringType      = std::string;
      using OtherStringType = std::wstring;

      constexpr static CharType literal( CharType theChar, OtherCharType ) {
          return theChar;
      }      
      template <std::size_t N>
      constexpr static const CharType *literal( const CharType (&theChars)[N], const OtherCharType (&)[N] ) {
          return &theChars[0];
      }
      static StringType adjust( const StringType &theString ) {
          return theString;
      }
      static StringType adjust( const OtherStringType &theString ) {
          return StringType( theString.begin(), theString.end() );
      }
      static CharType adjust( CharType theChar ) {
          return theChar;
      }
      static CharType adjust( OtherCharType theChar ) {
          return static_cast<CharType>(theChar);
      }
  };
  
  template <>
  struct CharTraits<wchar_t> {
      using CharType        = wchar_t;
      using OtherCharType   = char;
      using StringType      = std::wstring;
      using OtherStringType = std::string;
      
      constexpr static CharType literal( OtherCharType, CharType theChar ) {
          return theChar;
      }      
      template <std::size_t N>
      constexpr static const CharType *literal( const OtherCharType (&)[N], const CharType (&theChars)[N] ) {
          return &theChars[0];
      }
      static StringType adjust( const StringType &theString ) {
          return theString;
      }
      static StringType adjust( const OtherStringType &theString ) {
          return StringType( theString.begin(), theString.end() );
      }
      static CharType adjust( CharType theChar ) {
          return theChar;
      }
      static CharType adjust( OtherCharType theChar ) {
          return static_cast<CharType>(theChar);
      }
  };
  
#define BABEL_JSON_PARSER_STRING_LITERAL( chartype, stringliteral ) \
babel::JSON::parser::CharTraits<chartype>::literal( stringliteral, L##stringliteral )
  
#define BABEL_JSON_PARSER_CHAR_LITERAL( chartype, charliteral ) \
babel::JSON::parser::CharTraits<chartype>::literal( charliteral, L##charliteral )
  
