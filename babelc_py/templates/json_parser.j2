  template <typename T, typename S>
  std::enable_if_t<std::numeric_limits<T>::is_integer && ! std::numeric_limits<T>::is_signed, T>
  toNumeric( const S &theImage ) {
      using Limits = std::numeric_limits<T>;
      std::uint64_t theValue;
      if (isNumericValue(theValue,theImage.c_str())) {
          if (theValue <= Limits::max()) {
            return theValue;
          }
      }
      else {
          double theDouble;
          if (isNumericValue(theDouble,theImage.c_str()) &&
                  (theDouble == static_cast<double>((theValue = static_cast<T>(theDouble))))) {
              return theValue;
          }
      }
      throw std::invalid_argument("Cannot convert " + CharTraits<char>::adjust(theImage) + " to an unsigned integer less or equal to " + std::to_string(Limits::max()));
  }
  
  template <typename T, typename S>
  std::enable_if_t<std::numeric_limits<T>::is_integer && std::numeric_limits<T>::is_signed, T>
  toNumeric( const S &theImage ) {
      using Limits = std::numeric_limits<T>;
      std::int64_t theValue;
      if (isNumericValue(theValue,theImage.c_str())) {
          if ((Limits::min() <= theValue) && (theValue <= Limits::max())) {
            return theValue;
          }
      }
      else {
          double theDouble;
          if (isNumericValue(theDouble,theImage.c_str()) &&
                  (theDouble == static_cast<double>((theValue = static_cast<T>(theDouble))))) {
              return theValue;
          }
      }
      throw std::invalid_argument("Cannot convert " + CharTraits<char>::adjust(theImage) + " to a signed integer in range [" + 
                                    std::to_string(Limits::min()) + " .. " + std::to_string(Limits::max()));
  }
  
  template <typename T, typename S>
  std::enable_if_t< !std::numeric_limits<T>::is_integer, T>
  toNumeric( const S &theImage ) {
      using Limits = std::numeric_limits<T>;
      double theValue;
      if (isNumericValue(theValue,theImage.c_str()) && (Limits::lowest() <= theValue) && (theValue <= Limits::max())) {
          return theValue;
      }
      throw std::invalid_argument("Cannot convert " + CharTraits<char>::adjust(theImage) + " to a floating point in range [" + 
                                    std::to_string(Limits::lowest()) + " .. " + std::to_string(Limits::max()));
  }
  
  struct ValueBase;
  using  Value = std::unique_ptr<const ValueBase>;

  struct ValueBase {
    ValueBase( int theLine, int theColumn ) : itsLine(theLine), itsColumn(theColumn) {}
    std::string getLocation() const {
        std::string theResult("Close to line ");
        return theResult.append( std::to_string( itsLine ))
                .append(" column ")
                .append( std::to_string(itsColumn))
                .append(" : ");
    }
    virtual ~ValueBase() = default;
  private:
    int itsLine;
    int itsColumn;
  };

  template <class StringType>
  struct String : public ValueBase {
    using ValueBase::ValueBase;
    StringType itsValue;
  };

  template <class StringType>
  struct Number : public ValueBase {
    StringType itsValue;
    Number( StringType &&value, int theLine, int theColumn ) 
    : ValueBase(theLine,theColumn), itsValue(std::move(value)) {
    }
    
    template <typename T>
    T getNumericValue() const {
        return toNumeric<T,StringType>(itsValue);
    }
  };

  template <class StringType>
  struct Object : public ValueBase {
    using ValueBase::ValueBase;
    std::map<StringType,Value> itsValue;
  };

  struct Array : public ValueBase {
    using ValueBase::ValueBase;
    std::vector<Value> itsValue;
  };

  struct Boolean : public ValueBase {
    bool itsValue;

    Boolean( bool value, int theLine, int theColumn ) 
    : ValueBase(theLine,theColumn), itsValue(value) {}
  };

  struct Null : public ValueBase {
    using ValueBase::ValueBase;
  };

  template <typename TargetType>
  const TargetType &upcast( const Value &theValue, const char *theTargetTypeName ) {
      const char *theError;
      
      if (theValue) {
          if (const auto theUpcastedPtr = dynamic_cast<const TargetType *>(theValue.get())) {
              return *theUpcastedPtr;
          }
          else {
            theError = "Type is not expected ";
          }
      }
      else {
          theError = "Attempt to dereference null ";
      }
      std::string theMessage( theValue ? theValue->getLocation() : std::string("") );
      throw std::invalid_argument( std::move( theMessage.append( theError ).append( theTargetTypeName ) ) );
  }

#define BABEL_JSON_PARSER_UPCAST( targetType, theValue ) \
  (babel::JSON::parser::upcast<babel::JSON::parser::targetType>(theValue, #targetType))


  inline bool          isWhiteSpace( wchar_t c ) { return std::iswspace(c);  }
  inline bool          isWhiteSpace( char    c ) { return std::isspace(c);   }
  inline bool          isDelimiter ( wchar_t c ) { return isWhiteSpace(c) || std::wcschr(L":,}]",c); }
  inline bool          isDelimiter ( char    c ) { return isWhiteSpace(c) || std::strchr( ":,}]",c); }

  //======================================================================

  template <class CharT, class Traits >
  PositionedStream<CharT,Traits> &
  skipWhiteSpace( PositionedStream<CharT,Traits> &fromStream ) {
    CharT theNextChar;
    for (;;) {
      if       (!fromStream.get(theNextChar)) {                                 break; }
      else if (isWhiteSpace(theNextChar))    {                                 continue; }
      else                                   { fromStream.putback(theNextChar); break; }
    }
    return fromStream;
  }

  //======================================================================

  template <class CharT, class Traits >
  PositionedStream<CharT,Traits> &
  readWord( PositionedStream<CharT,Traits> &fromStream, std::basic_string<CharT,Traits> &theWord) {
    CharT theNextChar;
    for (;;) {
      if       (!fromStream.get(theNextChar)) {                                  break;    }
      else if (isDelimiter(theNextChar))     { fromStream.putback(theNextChar); break;    }
      else                                    { theWord.push_back(theNextChar);  continue; }
    }
    return fromStream;
  }


