  std::enable_if_t< std::is_same< unsigned long, T>::value, T> 
  textToInteger( const wchar_t *s, wchar_t **e, int theBase ) {
    return std::wcstoul( s, e, theBase );
  }
  
  template <typename T>
  std::enable_if_t< std::is_same< signed long long, T>::value, T> 
  textToInteger( const char *s, char **e, int theBase ) {
    return std::strtoll( s, e, theBase );
  }
  
