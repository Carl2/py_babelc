  template <typename CharT, typename Integer>
  std::enable_if_t<std::numeric_limits<Integer>::is_integer, bool> 
  isNumericHexValue( Integer &theConvertedValue, const CharT *theStringToConvert ) {
    return isNumericValue<CharT,Integer>( 
                  theConvertedValue, 
                  theStringToConvert, 
                  +[](const CharT *s, CharT **e) {
                    return textToInteger<Integer> (s, e, 16 ); 
                  } );
  }


