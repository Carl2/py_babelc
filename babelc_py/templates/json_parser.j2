  template <typename T>
  std::enable_if_t< std::is_same< unsigned long long, std::remove_cv_t<T>>::value, unsigned long long> 
  textToInteger( const char *s, char **e, int theBase ) {
    return std::strtoull( s, e, theBase );
  }
  
  template <typename T>
  std::enable_if_t< std::is_same< unsigned long long, T>::value, T> 
  textToInteger( const wchar_t *s, wchar_t **e, int theBase ) {
    return std::wcstoull( s, e, theBase );
  }
  
