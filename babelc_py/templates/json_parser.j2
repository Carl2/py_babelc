  template <class CharT, class Traits >
  Value
  readString( PositionedStream<CharT,Traits> &fromStream ) {
    using StringType = std::basic_string<CharT, Traits>;

    constexpr CharT _BACKSLASH  = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'\\');
    constexpr CharT _t          = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'t');
    constexpr CharT _TAB        = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'\t');
    constexpr CharT _n          = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'n');
    constexpr CharT _NEWLINE    = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'\n');
    constexpr CharT _r          = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'r');
    constexpr CharT _RETURN     = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'\r');
    constexpr CharT _v          = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'v');
    constexpr CharT _VTAB       = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'\v');
    constexpr CharT _f          = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'f');
    constexpr CharT _FORMFEED   = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'\f');
    constexpr CharT _DQUOTE     = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'"');
    constexpr CharT _SLASH      = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'/');
    constexpr CharT _u          = BABEL_JSON_PARSER_CHAR_LITERAL(CharT,'u');

    auto theString     = std::make_unique<String<StringType>>(fromStream.line(),fromStream.column());
    bool  escapeNext   = false;
    CharT theNextChar;
    
    while (fromStream.get(theNextChar)) {

      if (escapeNext) {
        escapeNext = false;  
        switch (theNextChar) {
        case _BACKSLASH : theString->itsValue.push_back(_BACKSLASH); break;
        case _t         : theString->itsValue.push_back(_TAB);       break;
        case _n         : theString->itsValue.push_back(_NEWLINE);   break;
        case _r         : theString->itsValue.push_back(_RETURN);    break;
        case _v         : theString->itsValue.push_back(_VTAB);      break;
        case _f         : theString->itsValue.push_back(_FORMFEED);  break;
        case _DQUOTE    : theString->itsValue.push_back(_DQUOTE);    break;
        case _SLASH     : theString->itsValue.push_back(_SLASH);     break;
        case _u:
          {
            std::uint16_t theCharValue;
                 
            if (readUnsigned( fromStream, theCharValue )) {
              theString->itsValue.push_back(static_cast<CharT>(theCharValue));
            }
            else {
              throw fromStream.makePositionedException("JSON unicode parse error.");
            }
          }
          break;
        default:
           throw fromStream.makePositionedException("JSON string escape sequence parse error.");
        }
      }
      else if (theNextChar == _DQUOTE) {
        return theString;
      }
      else if (theNextChar == _BACKSLASH) {
          escapeNext = true;
      }
      else {
        theString->itsValue.push_back( theNextChar );
      }
    }

    return Value();
  }

  //======================================================================

  template <class CharT, class Traits>
  PositionedStream<CharT,Traits> &
  readItem( PositionedStream<CharT,Traits> &fromStream, const std::unique_ptr<Object< std::basic_string<CharT,Traits> > >&theList ) {
    auto theNextKey       = readValue(fromStream);
    auto theNextKeyString = dynamic_cast<const String<std::basic_string<CharT,Traits>>*>(theNextKey.get());

    if (theNextKeyString != nullptr) {
      CharT theNextChar;

      if (skipWhiteSpace(fromStream).get(theNextChar) && (theNextChar == BABEL_JSON_PARSER_CHAR_LITERAL(CharT,':')) &&
          theList->itsValue.emplace(std::make_pair(std::move(theNextKeyString->itsValue),readValue(fromStream))).first->second) {
        return fromStream;
      }
    } 
    
    throw fromStream.makePositionedException("Failed to read JSON name-value pair.");
  }

  //======================================================================

  template <class CharT, class Traits>
  PositionedStream<CharT,Traits> &
  readItem( PositionedStream<CharT,Traits> &fromStream, const std::unique_ptr<Array> &theList ) {
    if (auto theNextValue = readValue(fromStream)) {
      theList->itsValue.emplace_back( std::move(theNextValue) );
      return fromStream;
    }
    else {
      throw fromStream.makePositionedException("Failed to read JSON array item.");
    }
  }

