  template <class CharT, class Traits,class Target>
  PositionedStream<CharT,Traits> &
  readUnsigned( PositionedStream<CharT,Traits> &fromStream, Target &theConvertedValue ) {
    unsigned long theTemporary;

    static_assert(sizeof(theConvertedValue) <= sizeof(theTemporary), "To large target size");

    std::array<CharT,(sizeof(theConvertedValue)*2 + 1)> theDigits{};
    std::size_t                                          i = 0;

    while (fromStream.get(theDigits[i])) {
      if (++i == (theDigits.size()-1)) {
        if (isNumericHexValue(theTemporary, &theDigits[0])) {
          theConvertedValue = static_cast<Target>(theTemporary);
        }
        else {
          throw fromStream.makePositionedException("Expected a unicode hex number.");
        }
        break;
      }
    }
    return fromStream;
  }

