{# Task 10b: Top-level IPC header orchestrator. #}
{% import "enum.j2" as enum_tpl %}
{% import "container.j2" as container_tpl %}
{% import "struct.j2" as struct_tpl %}
{% import "interface.j2" as interface_tpl %}

#ifndef {{ guard_name }}
#define {{ guard_name }}

#include <memory>
#include <type_traits>
#include <algorithm>
#include <tuple>
#include <array>

#include "{{ header_path }}"

{% for iface in interfaces %}
{{ interface_tpl.forward_declarations(iface) }}
{% endfor %}
//==============================================================================
// Below here is only implementation code which may be perused at leisure
// by an interested reader.

{% include "babel_helpers.j2" %}
{% for kind in container_kinds_used %}
{% include "container_helpers.j2" %}
{% endfor %}
{% include "babel_helpers_last.j2" %}
{% include "helpers.j2" %}
{% for kind, item in ordered %}
{% if kind == "container" %}{{ container_tpl.declaration(item) }}{% elif kind == "enum" %}{{ enum_tpl.declaration(item) }}{% else %}{{ struct_tpl.declaration(item) }}{% endif %}
{% endfor %}
{% for kind, item in ordered %}
{% if kind == "container" %}{{ container_tpl.implementation(item) }}{% elif kind == "enum" %}{{ enum_tpl.implementation(item) }}{% else %}{{ struct_tpl.implementation(item) }}{% endif %}
{% endfor %}
{% for iface in interfaces %}
{{ interface_tpl.stubs(iface) }}
{% endfor %}
{% for iface in interfaces %}
{{ interface_tpl.implementations(iface) }}
{% endfor %}
#endif
