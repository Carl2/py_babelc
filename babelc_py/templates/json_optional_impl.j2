{# Task 14: optional adapter implementations. ns = 'std' or 'boost'. #}
#ifndef HAVE_{{ ns|upper }}_OPTIONAL_JSON_IMPLEMENTATIONS
#define HAVE_{{ ns|upper }}_OPTIONAL_JSON_IMPLEMENTATIONS

{{ ns_begin(['babel', 'JSON'], cpp_std) }}

    template <class CharT, typename T>
    void
    interpretJSON( const babel::JSON::parser::Value &theJSONValue, {{ ns }}::optional<T> &theValue ) {
        if (dynamic_cast<const babel::JSON::parser::Null*>(theJSONValue.get())) {
            theValue = {{ ns }}::optional<T>();
        }
        else if (theValue) {
            interpretJSON<CharT>( theJSONValue, *theValue );
        }
        else {
            T theTemporary;
            interpretJSON<CharT>( theJSONValue, theTemporary );
            theValue = std::move(theTemporary);
        }
    }

    template <class CharT, class Traits, class T>
    std::basic_ostream<CharT,Traits>&
    writeJSON( std::basic_ostream<CharT,Traits>&theStream, const {{ ns }}::optional<T> &theValue, Indent theIndent) {
        return theValue ? writeJSON( theStream, *theValue, theIndent ) : (theStream << "null");
    }

{{ ns_end(['babel', 'JSON'], cpp_std) }}


#endif
