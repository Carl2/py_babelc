{# Task 7: Enum IPC validation — declaration and implementation sections. #}
{# Context: enum (EnumType) #}
{% macro declaration(enum) %}
#ifndef HAVE_BABEL_IPC_{{ enum.qualified_name|guard_macro }}_IPC_DECLARATIONS
#define HAVE_BABEL_IPC_{{ enum.qualified_name|guard_macro }}_IPC_DECLARATIONS

{{ enum|ns_open }}

    void IpcEnumValidate( {{ enum.name }} &theTarget, {{ enum.name }} theValue, std::string &theErrorString ) __attribute__((weak));

{{ enum|ns_close }}


#endif
{% endmacro %}
{% macro implementation(enum) %}
#ifndef HAVE_BABEL_IPC_{{ enum.qualified_name|guard_macro }}_IPC_IMPLEMENTATIONS
#define HAVE_BABEL_IPC_{{ enum.qualified_name|guard_macro }}_IPC_IMPLEMENTATIONS

{{ enum|ns_open }}

    void IpcEnumValidate( {{ enum.name }} &theTarget, {{ enum.name }} theValue, std::string &theErrorString )  {
        switch (theValue) {
        {% for val in enum.enumerators %}
        case {{ enum.name }}::{{ val.name }}:
        {% endfor %}
            theTarget = theValue;
            return;
        }
        if (!theErrorString.empty()) { theErrorString += ", "; };    theErrorString += (std::to_string(static_cast<{{ enum.underlying_type }}>(theValue)) + " not valid for {{ enum|qualified }}");
    }

{{ enum|ns_close }}


#endif
{% endmacro %}
