    template <class CharT, typename T>
    std::enable_if_t< std::is_arithmetic< T >::value && !std::numeric_limits<T>::has_quiet_NaN && !std::is_same< T, bool >::value>
    interpretJSON( const babel::JSON::parser::Value &theJSONValue, T &theValue );

    template <class CharT, typename T>
    std::enable_if_t< std::is_arithmetic< T >::value && std::numeric_limits<T>::has_quiet_NaN && !std::is_same< T, bool >::value>
    interpretJSON( const babel::JSON::parser::Value &theJSONValue, T &theValue );

    template <class CharT, typename T>
    std::enable_if_t< std::is_same< T, std::basic_string<CharT> >::value>
    interpretJSON( const babel::JSON::parser::Value &theJSONValue, T &theValue );

    template <class CharT, typename T>
    std::enable_if_t< std::is_same< T, typename ::babel::JSON::parser::CharTraits<CharT>::OtherStringType >::value>
    interpretJSON( const babel::JSON::parser::Value &theJSONValue, T &theValue );

    template <class CharT, typename T>
    std::enable_if_t< std::is_same< T, bool >::value >
    interpretJSON( const babel::JSON::parser::Value &theJSONValue, T &theValue );

    template <class CharT, typename T>
    std::enable_if_t< is_supported_container<T>::value && !is_fixed_container<T>::value && !is_map_container<T>::value >
    interpretJSON( const babel::JSON::parser::Value &theJSONValue, T &theValue );

    template <class CharT, typename T>
    std::enable_if_t< is_fixed_container<T>::value >
    interpretJSON( const babel::JSON::parser::Value &theJSONValue, T &theValue );

    template <class CharT, typename T>
    std::enable_if_t< is_map_container<T>::value  && std::is_same<typename T::key_type,std::basic_string<CharT>>::value>
    interpretJSON( const babel::JSON::parser::Value &theJSONValue, T &theValue );

    template <class CharT, typename T>
    std::enable_if_t< is_map_container<T>::value  && ! std::is_same<typename T::key_type,std::basic_string<CharT>>::value>
    interpretJSON( const babel::JSON::parser::Value &theJSONValue, T &theValue );

